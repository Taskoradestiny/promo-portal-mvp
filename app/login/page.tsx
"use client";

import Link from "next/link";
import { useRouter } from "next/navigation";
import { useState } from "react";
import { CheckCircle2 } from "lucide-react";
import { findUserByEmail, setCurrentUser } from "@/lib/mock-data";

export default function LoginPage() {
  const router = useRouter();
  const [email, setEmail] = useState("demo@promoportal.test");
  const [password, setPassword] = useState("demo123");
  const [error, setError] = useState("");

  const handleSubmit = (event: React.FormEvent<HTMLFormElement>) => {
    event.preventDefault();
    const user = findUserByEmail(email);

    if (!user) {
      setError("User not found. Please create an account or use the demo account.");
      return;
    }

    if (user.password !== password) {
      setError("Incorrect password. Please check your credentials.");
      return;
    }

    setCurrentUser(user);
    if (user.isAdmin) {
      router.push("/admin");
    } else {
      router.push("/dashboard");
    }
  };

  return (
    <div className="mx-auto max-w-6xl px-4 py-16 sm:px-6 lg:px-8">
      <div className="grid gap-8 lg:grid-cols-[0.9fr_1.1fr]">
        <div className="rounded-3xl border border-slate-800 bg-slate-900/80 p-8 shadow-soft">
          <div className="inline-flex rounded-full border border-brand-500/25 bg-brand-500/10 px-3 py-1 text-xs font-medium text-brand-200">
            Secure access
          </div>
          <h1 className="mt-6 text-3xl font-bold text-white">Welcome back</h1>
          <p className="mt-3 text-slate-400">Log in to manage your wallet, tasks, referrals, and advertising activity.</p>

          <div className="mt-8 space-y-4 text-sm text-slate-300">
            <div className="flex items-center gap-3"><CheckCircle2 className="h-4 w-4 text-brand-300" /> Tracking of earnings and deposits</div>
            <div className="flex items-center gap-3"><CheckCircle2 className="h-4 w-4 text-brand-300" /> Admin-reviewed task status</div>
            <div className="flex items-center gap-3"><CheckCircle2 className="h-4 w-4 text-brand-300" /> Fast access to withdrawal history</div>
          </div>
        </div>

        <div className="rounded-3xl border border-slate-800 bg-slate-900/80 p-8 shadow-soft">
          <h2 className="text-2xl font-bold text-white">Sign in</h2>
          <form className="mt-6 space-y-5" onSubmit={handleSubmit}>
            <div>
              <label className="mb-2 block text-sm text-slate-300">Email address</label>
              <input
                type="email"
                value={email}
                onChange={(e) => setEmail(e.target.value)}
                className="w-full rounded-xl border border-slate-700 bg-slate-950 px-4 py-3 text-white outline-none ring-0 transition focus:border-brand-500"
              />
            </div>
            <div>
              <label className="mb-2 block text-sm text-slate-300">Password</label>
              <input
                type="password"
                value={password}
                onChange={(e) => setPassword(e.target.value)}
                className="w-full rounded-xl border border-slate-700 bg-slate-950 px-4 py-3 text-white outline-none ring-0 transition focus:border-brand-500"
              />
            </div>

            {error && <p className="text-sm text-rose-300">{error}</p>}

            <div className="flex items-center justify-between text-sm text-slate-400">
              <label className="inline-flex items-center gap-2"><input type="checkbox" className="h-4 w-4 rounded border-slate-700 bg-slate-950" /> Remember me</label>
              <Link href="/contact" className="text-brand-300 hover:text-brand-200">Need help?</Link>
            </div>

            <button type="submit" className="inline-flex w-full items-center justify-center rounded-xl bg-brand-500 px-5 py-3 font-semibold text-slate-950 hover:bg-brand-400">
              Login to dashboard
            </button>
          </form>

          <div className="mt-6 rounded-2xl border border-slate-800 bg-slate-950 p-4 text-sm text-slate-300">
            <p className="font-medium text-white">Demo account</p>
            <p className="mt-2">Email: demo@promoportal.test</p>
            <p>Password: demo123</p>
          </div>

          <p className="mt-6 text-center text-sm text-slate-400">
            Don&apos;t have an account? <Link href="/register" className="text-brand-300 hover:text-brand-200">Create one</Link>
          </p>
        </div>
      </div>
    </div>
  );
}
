export function getStoredUsers(): UserProfile[] {
  if (typeof window === "undefined") return [demoUser, demoAdmin];
  const stored = localStorage.getItem("promo_portal_users");

  if (!stored) {
    localStorage.setItem("promo_portal_users", JSON.stringify([demoUser, demoAdmin]));
    return [demoUser, demoAdmin];
  }

  try {
    return JSON.parse(stored) as UserProfile[];
  } catch {
    return [demoUser, demoAdmin];
  }
}

export function saveUsers(users: UserProfile[]) {
  if (typeof window === "undefined") return;
  localStorage.setItem("promo_portal_users", JSON.stringify(users));
}

export function upsertUser(user: UserProfile) {
  const users = getStoredUsers();
  const index = users.findIndex((item) => item.email === user.email);

  if (index >= 0) {
    users[index] = user;
  } else {
    users.push(user);
  }

  saveUsers(users);
}

export function findUserByEmail(email: string) {
  return getStoredUsers().find((user) => user.email.toLowerCase() === email.toLowerCase());
}

export function readCurrentUser(): UserProfile | null {
  if (typeof window === "undefined") return demoUser;
  const raw = localStorage.getItem("promo_portal_current_user");
  if (!raw) return null;

  try {
    return JSON.parse(raw) as UserProfile;
  } catch {
    return null;
  }
}

export function setCurrentUser(user: UserProfile | null) {
  if (typeof window === "undefined") return;
  if (!user) {
    localStorage.removeItem("promo_portal_current_user");
    return;
  }

  localStorage.setItem("promo_portal_current_user", JSON.stringify(user));
}
